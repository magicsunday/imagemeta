{
    "name": "magicsunday/imagemeta",
    "description": "Unified EXIF 3.0 / XMP / IPTC / ISOBMFF metadata for PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rico Sonntag",
            "email": "mail@ricosonntag.de",
            "homepage": "https://ricosonntag.de",
            "role": "Developer"
        }
    ],
    "config": {
        "bin-dir": ".build/bin",
        "vendor-dir": ".build/vendor",
        "discard-changes": true,
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "require": {
        "php": ">=8.4.0 <8.6.0",
        "ext-ctype": "*",
        "ext-date": "*",
        "ext-fileinfo": "*",
        "ext-hash": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-pcre": "*",
        "ext-xmlreader": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.85",
        "overtrue/phplint": "^9.0",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MagicSunday\\ImageMeta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MagicSunday\\ImageMeta\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci:cgl": [
            "php-cs-fixer fix --config .php-cs-fixer.dist.php --diff --verbose"
        ],
        "ci:rector": [
            "rector process --config rector.php"
        ],
        "ci:test:php:cgl": [
            "@ci:cgl --dry-run"
        ],
        "ci:test:php:lint": [
            "phplint --configuration .phplint.yml"
        ],
        "ci:test:php:phpstan": [
            "phpstan analyze --configuration phpstan.neon --memory-limit=-1"
        ],
        "ci:test:php:phpstan:baseline": [
            "phpstan analyze --configuration phpstan.neon --memory-limit=-1 --generate-baseline phpstan-baseline.neon --allow-empty-baseline"
        ],
        "ci:test:php:rector": [
            "@ci:rector --dry-run"
        ],
        "ci:test:php:compliance": [
            "php scripts/analyze-exif-compliance.php 50"
        ],
        "ci:test:php:unit": [
            "phpunit --configuration phpunit.xml"
        ],
        "ci:test:php:unit:coverage": [
            "XDEBUG_MODE=coverage phpunit --configuration phpunit.xml --coverage-html coverage/"
        ],
        "ci:test:php:cpd": [
            "npx jscpd --config .jscpd.json"
        ],
        "ci:test": [
            "@ci:test:php:lint",
            "@ci:test:php:cgl",
            "@ci:test:php:rector",
            "@ci:test:php:phpstan",
            "@ci:test:php:compliance",
            "@ci:test:php:unit",
            "@ci:test:php:cpd"
        ],
        "post-update-cmd": [
            "npm install jscpd"
        ]
    }
}
