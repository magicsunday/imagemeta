includes:
    - %currentWorkingDirectory%/.build/vendor/magicsunday/coding-standard/phpstan/base.neon
    - %currentWorkingDirectory%/phpstan-baseline.neon

parameters:
    phpVersion:
        min: 80400
        max: 80500

    tmpDir: %currentWorkingDirectory%/.build/cache/.phpstan.cache

    paths:
        - %currentWorkingDirectory%/src/
        - %currentWorkingDirectory%/tests/

    excludePaths:
        - %currentWorkingDirectory%/.build/

    ignoreErrors:
        # A test method that calls a throwing API documents nothing by carrying @throws: PHPUnit
        # catches whatever it throws and turns it into a failure (or an expectException pass).
        # Checked-exception contracts are enforced on src/, where callers depend on them.
        -
            identifier: missingType.checkedException
            path: %currentWorkingDirectory%/tests/*

        # Stream delegates its primitive reads to ByteReader, which pulls the bytes through a
        # closure over Stream::read(). PHPStan cannot see through the closure, so
        # ByteReader::readU64BE() declares only ParseError, although a truncated stream throws
        # BoundsError at runtime; the catch in looksLikeIsoBmff() is reached.
        -
            identifier: catch.neverThrown
            message: '#^Dead catch - MagicSunday\\ImageMeta\\Core\\BoundsError is never thrown in the try block\.$#'
            path: %currentWorkingDirectory%/src/Detect/FormatDetector.php
